# Only needed when you host the site somewhere other than Whop (Vercel, Node).
# On Whop hosting the API key and account ID are provided for you.

# A company API key from https://whop.com/dashboard/developer with permissions
# for leads, members, payments, setup intents, invoices, products and plans.
WHOP_API_KEY=

# Your business ID (biz_...). Defaults to the one in src/config/whop.generated.json.
WHOP_ACCOUNT_ID=

# Passcode for the /office job desk, where staff bill final balances.
OFFICE_PASSCODE=

# Optional: a key from https://sandbox.whop.com/dashboard/developer to turn on
# ?mode=test checkouts with test cards. Run `pnpm whop:sync --sandbox` first.
WHOP_SANDBOX_API_KEY=
